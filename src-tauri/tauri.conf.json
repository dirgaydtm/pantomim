{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pantomim",
  "version": "0.1.0",
  "identifier": "io.github.dirgaydtm.pantomim",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png"
    ],
    "fileAssociations": [
      {
        "ext": [
          "seb"
        ],
        "mimeType": "application/seb",
        "name": "SEB configuration"
      }
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/mime/packages/pantomim.xml": "linux/seb.xml"
        },
        "desktopTemplate": "linux/pantomim.desktop"
      },
      "rpm": {
        "files": {
          "/usr/share/mime/packages/pantomim.xml": "linux/seb.xml"
        },
        "desktopTemplate": "linux/pantomim.desktop"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "seb",
          "sebs"
        ]
      }
    }
  }
}
