{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local UI only; exam pages get no IPC",
  "windows": ["dialog-*"],
  "webviews": ["*-taskbar"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-always-on-top"
  ]
}
